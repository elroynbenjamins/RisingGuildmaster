import React, { useEffect, useRef, useState } from "react";
import { ImageBackground, Pressable, ScrollView, StyleSheet, Text, View } from "react-native";
import { ActionButton, BackButton, MiniMeter, Panel, SectionTitle, StatusChip, colors } from "../../components/ui";
import { REGIONS } from "../../data/world/regions";
import { SETTLEMENTS } from "../../data/world/settlements";
import { WORLD_ART } from "../../data/world/worldArt";
import { RACE_HOMELANDS } from "../../data/recruitment/raceHomelands";
import { RACES } from "../../data/races/races";
import type { GuildState } from "../../game/guild/types";
import { isBossAvailable, isRegionCompleted } from "../../game/world/regionService";
import { discoverRegionSettlements } from "../../game/world/worldService";
import { buyRations, getRationBundleAmount, travelGuildToRegion } from "../../game/world/travelService";
import { getRegionProgressSummary, getRegionTravelPreview, travelStateLabel } from "../../game/world/worldMapPresentationService";
import type { RegionTravelState } from "../../game/world/worldMapPresentationService";
import type { WorldEventDefinition } from "../../game/world/worldTypes";
import { WORLD_NAME } from "../../game/world/worldState";
import { mapChromeStyles } from "../../ui/worldMap";
import type { RandomSource } from "../../utils/random";
import { GameIcon } from "../../components/icons/GameIcon";
import { isMatchingDoubleTap, type TapRecord } from "../../utils/doubleTap";
import { GAME_CONFIG } from "../../config/gameConfig";
import { useGameDialog } from "../../components/dialogs/GameDialog";
import { needsStarterJourneyTravel, needsStarterRoadEncounter } from "../../game/onboarding/starterJourneyService";
import { acknowledgeTimeAdvanceGuidance, getTimeAdvanceGuidance, payrollWarningLine } from "../../game/onboarding/timeAndPayrollGuidanceService";
import { formatGameId } from "../../ui/textFormat";

interface WorldMapProps {
  guild: GuildState;
  random: RandomSource;
  onBack?: () => void;
  updateGuild(guild: GuildState): void;
  openQuest(id: string): void;
  openRegion(id: string): void;
  openCampaign(): void;
  openEvent(event: WorldEventDefinition): void;
}

function travelTone(state: RegionTravelState): "neutral" | "gold" | "good" | "danger" | "blue" {
  if (state === "ready" || state === "current") return "good";
  if (state === "underlevelled" || state === "danger") return "danger";
  if (state === "locked" || state === "blocked") return "neutral";
  return "blue";
}

export function WorldMapScreen({ guild, random, onBack, updateGuild, openRegion, openCampaign, openEvent }: WorldMapProps) {
  const { showDialog } = useGameDialog();
  const [selectedId, setSelectedId] = useState(guild.world.currentRegionId);
  const [message, setMessage] = useState<string>();
  const [showRegionIntel, setShowRegionIntel] = useState(false);
  const lastRegionTap = useRef<TapRecord | null>(null);
  const journeyPrompted = useRef(false);
  const selected = REGIONS[selectedId]!;
  const currentRegion = REGIONS[guild.world.currentRegionId]!;
  const currentSettlement = guild.world.currentSettlementId ? SETTLEMENTS[guild.world.currentSettlementId] : undefined;
  const unlocked = guild.world.unlockedRegionIds.includes(selectedId);
  const current = guild.world.currentRegionId === selectedId;
  const homelandContacts = Object.values(RACE_HOMELANDS).filter((homeland) => homeland.regionId === selectedId);
  const selectedProgress = getRegionProgressSummary(guild, selectedId);
  const travelPreview = getRegionTravelPreview(guild, selectedId);
  const selectedThreat = travelPreview.threat;

  useEffect(() => {
    const mustTravel = needsStarterJourneyTravel(guild); const mustAnswerAlarm = needsStarterRoadEncounter(guild);
    if ((!mustTravel && !mustAnswerAlarm) || journeyPrompted.current) return;
    journeyPrompted.current = true;
    showDialog({ title: mustAnswerAlarm ? "The Caravan Still Needs You" : "Travel Tutorial: Brambleford", eyebrow: "CHAPTER 1 COMPANY TRIAL", message: mustAnswerAlarm ? "You have reached Brambleford, but Aldren's road alarm is unresolved. Open the Greenveil map and select Brambleford to resume the encounter. Returning to the alarm costs no additional day or rations." : "Your three-hero escort is ready. Open Greenveil's regional map, select Brambleford, then walk there. The first day of travel will trigger Aldren Vale's caravan ambush.", actions: [{ label: mustAnswerAlarm ? "Resume at Brambleford" : "Open Greenveil Map", tone: "primary", onPress: () => openRegion("greenveil") }] });
  }, [guild, openRegion, showDialog]);

  const selectRegion = (regionId: string) => {
    const timestamp = Date.now();
    const doubleTapped = isMatchingDoubleTap(lastRegionTap.current, regionId, timestamp);
    lastRegionTap.current = doubleTapped ? null : { targetKey: regionId, timestamp };
    setSelectedId(regionId);
    if (regionId !== selectedId) setShowRegionIntel(false);
    setMessage(undefined);
    if (doubleTapped) openRegion(regionId);
  };

  const completeTravel = (sourceGuild: GuildState) => {
    try {
      const preview = getRegionTravelPreview(sourceGuild, selectedId);
      const result = travelGuildToRegion(sourceGuild, selectedId, preview.partySize, random);
      const world = discoverRegionSettlements(result.guild.world, selectedId);
      updateGuild({ ...result.guild, world });
      setMessage(`ARRIVED · ${selected.name} · Day ${result.guild.currentDay} · ${result.rationCost} rations used${result.tier ? ` · ${result.tier.toUpperCase()} road event` : " · quiet road"}`);
      if (result.event) openEvent(result.event);
    } catch (error) {
      setMessage(error instanceof Error ? error.message : "Travel failed");
    }
  };

  const travel = () => {
    const guidance = getTimeAdvanceGuidance(guild, travelPreview.days); const payrollLine = payrollWarningLine(guidance);
    if (!guidance.showCalendarPrimer && !payrollLine) { completeTravel(guild); return; }
    showDialog({ title: payrollLine ? "Journey Crosses Payroll" : "Travel Advances Time", eyebrow: guidance.showCalendarPrimer ? "TIME & PAYROLL TUTORIAL" : "PAYROLL WARNING", message: `${guidance.showCalendarPrimer ? "Travel advances the guild calendar one day at a time. Recovery, projects, candidates, contracts, regional threats, tavern income, and payroll resolve on the road." : `This journey advances the calendar by ${travelPreview.days} day${travelPreview.days === 1 ? "" : "s"}.`}${payrollLine ? `\n\n${payrollLine}\nTreasury now: ${guild.gold} gold.` : ""}\n\nArrive on Day ${guidance.targetDay}; consume ${travelPreview.rationCost} rations.`, tone: guidance.projectedShortfall > 0 ? "danger" : "default", actions: [{ label: "Stay Here", tone: "secondary" }, { label: "Begin Journey", tone: "primary", onPress: () => completeTravel(acknowledgeTimeAdvanceGuidance(guild, guidance)) }] });
  };

  return (
    <ScrollView contentContainerStyle={styles.content}>
      {onBack && <BackButton onPress={onBack} />}
      <Text style={styles.eyebrow}>FIELD COMMAND · WORLD MAP</Text>
      <Text style={styles.title}>{WORLD_NAME}</Text>
      <Text style={styles.subtitle}>Chapter {guild.world.campaignChapter} · Day {guild.currentDay} · {currentRegion.name}{currentSettlement ? ` / ${currentSettlement.name}` : ""}</Text>

      <Panel style={styles.commandBar}>
        <View style={styles.commandHeader}>
          <View style={styles.commandLocationIcon}><GameIcon id="current" size={28} framed={false} /></View>
          <View style={styles.flex}>
            <Text style={styles.commandEyebrow}>GUILD POSITION</Text>
            <Text style={styles.commandLocation}>{currentSettlement?.name ?? currentRegion.name}</Text>
            <Text style={styles.commandSub}>{currentRegion.name} · {travelPreview.partySize} field hero{travelPreview.partySize === 1 ? "" : "es"}</Text>
          </View>
          <View style={styles.supplyPlate}><Text style={styles.supplyValue}>{guild.rations}</Text><Text style={styles.supplyLabel}>RATIONS</Text></View>
        </View>
      </Panel>

      <View style={styles.overview}>
        <View style={styles.overviewStat}><Text style={styles.overviewValue}>{guild.world.unlockedRegionIds.length}/{Object.keys(REGIONS).length}</Text><Text style={styles.overviewLabel}>REGIONS OPEN</Text></View>
        <View style={styles.overviewStat}><Text style={styles.overviewValue}>{guild.world.discoveredSettlementIds.length}/{Object.keys(SETTLEMENTS).length}</Text><Text style={styles.overviewLabel}>SETTLEMENTS</Text></View>
        <View style={styles.overviewStat}><Text style={styles.overviewValue}>{travelPreview.partyAverageLevel ? travelPreview.partyAverageLevel.toFixed(1) : "—"}</Text><Text style={styles.overviewLabel}>FIELD AVG LV</Text></View>
      </View>

      <View style={mapChromeStyles.frame}>
        <ImageBackground source={WORLD_ART.eldoria} resizeMode="cover" style={mapChromeStyles.canvas} imageStyle={mapChromeStyles.image}>
          <View pointerEvents="none" style={styles.mapShade} />
          {Object.values(REGIONS).map((region) => {
            const isUnlocked = guild.world.unlockedRegionIds.includes(region.id);
            const isCurrent = guild.world.currentRegionId === region.id;
            const completed = isRegionCompleted(region.id, guild.world);
            const boss = isBossAvailable(region.id, guild.world);
            const selectedRegion = selectedId === region.id;
            const status = !isUnlocked ? "LOCKED" : isCurrent ? "CURRENT" : completed ? "COMPLETE" : boss ? "BOSS" : "OPEN";
            const markerIcon = !isUnlocked ? "locked" : isCurrent ? "current" : completed ? "complete" : boss ? "boss" : "region_open";
            const settlementDiscovered = region.settlementIds.some((id) => guild.world.discoveredSettlementIds.includes(id));
            return (
              <Pressable
                accessibilityHint="Tap once to inspect. Tap twice quickly to open the regional map."
                accessibilityLabel={`${region.name}, ${status.toLowerCase()}`}
                accessibilityRole="button"
                accessibilityState={{ selected: selectedRegion }}
                key={region.id}
                onPress={() => selectRegion(region.id)}
                style={({ pressed }: { pressed: boolean }) => [styles.node, { left: `${region.mapPosition.x * 100}%`, top: `${region.mapPosition.y * 100}%` }, !isUnlocked && styles.lockedNode, isCurrent && styles.currentNode, selectedRegion && styles.selectedNode, pressed && styles.pressedNode]}
              >
                <View style={[styles.marker, isCurrent && styles.currentMarker, boss && styles.bossMarker, selectedRegion && styles.selectedMarker]}><GameIcon id={markerIcon} size={28} framed={false} /></View>
                <Text numberOfLines={1} style={styles.nodeName}>{region.name}</Text>
                <Text style={styles.nodeState}>{status}</Text>
                {selectedRegion && <Text style={styles.nodeHint}>DOUBLE TAP · OPEN</Text>}
                {(guild.world.regionThreat?.[region.id] ?? 0) > 0 && <Text style={styles.threatBadge}>THREAT {guild.world.regionThreat?.[region.id]}</Text>}
                {settlementDiscovered && (selectedRegion || isCurrent) && <View style={styles.settlementRow}><GameIcon id="settlement" size={13} framed={false} /><Text style={styles.settlement}>{SETTLEMENTS[region.settlementIds[0]!]?.name}</Text></View>}
              </Pressable>
            );
          })}
        </ImageBackground>
        <View style={mapChromeStyles.legend}>
          <View style={styles.legendItem}><GameIcon id="current" size={14} framed={false}/><Text style={styles.legendText}>CURRENT</Text></View>
          <View style={styles.legendItem}><GameIcon id="region_open" size={14} framed={false}/><Text style={styles.legendText}>OPEN</Text></View>
          <View style={styles.legendItem}><GameIcon id="boss" size={14} framed={false}/><Text style={styles.legendText}>BOSS</Text></View>
          <View style={styles.legendItem}><GameIcon id="locked" size={14} framed={false}/><Text style={styles.legendText}>LOCKED</Text></View>
        </View>
      </View>
      <Text style={styles.gestureHint}>Tap a region to plan · Double tap the same marker to open its local map</Text>

      <Panel style={styles.routePanel}>
        <View style={styles.panelHeader}>
          <View style={styles.flex}><Text style={styles.panelEyebrow}>REGION DOSSIER</Text><Text style={styles.regionName}>{selected.name}</Text><Text style={styles.level}>Recommended level {selected.recommendedLevelMin}–{selected.recommendedLevelMax}</Text></View>
          <StatusChip label={travelStateLabel(travelPreview.state)} tone={travelTone(travelPreview.state)} />
        </View>
        <Text style={styles.description}>{selected.description}</Text>

        <View style={styles.regionStats}>
          <View style={styles.regionStat}><Text style={styles.regionStatValue}>{selectedProgress.completedQuests}/{selectedProgress.totalQuests}</Text><Text style={styles.regionStatLabel}>QUESTS</Text></View>
          <View style={styles.regionStat}><Text style={styles.regionStatValue}>{selectedProgress.discoveredSettlements}/{selectedProgress.totalSettlements}</Text><Text style={styles.regionStatLabel}>SETTLEMENTS</Text></View>
          <View style={styles.regionStat}><Text style={[styles.regionStatValue, selectedThreat >= 3 && styles.regionStatDanger]}>{selectedThreat}/4</Text><Text style={styles.regionStatLabel}>THREAT</Text></View>
        </View>
        <Text style={styles.progressLabel}>REGIONAL ORDERS · {selectedProgress.questPercent}%</Text>
        <MiniMeter value={selectedProgress.completedQuests} max={Math.max(1, selectedProgress.totalQuests)} color={colors.gold} height={7} />

        {!current && <View style={[styles.routePlan, travelPreview.blocker ? styles.routePlanBlocked : travelPreview.state === "underlevelled" || travelPreview.state === "danger" ? styles.routePlanDanger : styles.routePlanReady]}>
          <View style={styles.routePlanHeader}><Text style={styles.routePlanTitle}>ROUTE PLAN</Text><Text style={styles.routeArrow}>{currentRegion.name}  →  {selected.name}</Text></View>
          <View style={styles.routeNumbers}>
            <RouteStat label="TRAVEL" value={`${travelPreview.days}d`} />
            <RouteStat label="SUPPLIES" value={`${travelPreview.rationCost}`} />
            <RouteStat label="AFTER" value={`${travelPreview.rationsAfterTravel}`} />
            <RouteStat label="ARRIVE" value={`D${travelPreview.arrivalDay}`} />
          </View>
          {travelPreview.blocker && <Text style={styles.routeError}>{travelPreview.blocker}</Text>}
          {!travelPreview.blocker && travelPreview.partyAverageLevel > 0 && travelPreview.partyAverageLevel < selected.recommendedLevelMin && <Text style={styles.routeError}>HIGH RISK · Field party average Lv {travelPreview.partyAverageLevel.toFixed(1)} is below Lv {selected.recommendedLevelMin}.</Text>}
          {!travelPreview.blocker && travelPreview.payrollDue > 0 && <Text style={travelPreview.projectedPayrollShortfall > 0 ? styles.routeError : styles.routeWarning}>PAYROLL EN ROUTE · {travelPreview.payrollDue}g due{travelPreview.projectedPayrollShortfall > 0 ? ` · ${travelPreview.projectedPayrollShortfall}g projected unpaid` : ""}</Text>}
        </View>}
        {current && <View style={styles.currentPosition}><GameIcon id="current" size={20} framed={false}/><View style={styles.flex}><Text style={styles.currentPositionTitle}>GUILD PRESENT IN THIS REGION</Text><Text style={styles.currentPositionText}>{currentSettlement ? `Operating from ${currentSettlement.name}.` : "No settlement currently selected."}</Text></View></View>}

        <Pressable accessibilityRole="button" accessibilityState={{ expanded: showRegionIntel }} onPress={() => setShowRegionIntel((value) => !value)} style={styles.intelButton}><Text style={styles.intelLabel}>{showRegionIntel ? "− HIDE" : "+ SHOW"} REGIONAL INTELLIGENCE</Text></Pressable>
        {showRegionIntel && <View style={styles.intelBlock}>
          <IntelLine label="ENEMY FACTIONS" value={selected.enemyFactionIds.map(formatGameId).join(" · ") || "Unknown"} />
          {homelandContacts.length > 0 && <IntelLine label="RECRUITMENT HOMELAND" value={homelandContacts.map((homeland) => `${RACES[homeland.raceId].name} · ${homeland.locationName}`).join(" · ")} />}
          <IntelLine label="KNOWN SETTLEMENTS" value={selected.settlementIds.filter((id) => guild.world.discoveredSettlementIds.includes(id)).map((id) => SETTLEMENTS[id]?.name ?? formatGameId(id)).join(" · ") || "None yet"} />
          {selectedThreat > 0 && <Text style={styles.threat}>Regional threat {selectedThreat}/4 · Delaying unresolved dangers can strengthen enemies and disrupt settlements.</Text>}
          {selected.bossQuestId && <Text style={styles.boss}>REGIONAL BOSS · {guild.world.completedQuestIds.includes(selected.bossQuestId) ? "DEFEATED" : "UNRESOLVED"}</Text>}
          <Text style={styles.roadTitle}>DIRECT ROADS</Text>
          <View style={styles.roads}>{selected.connectedRegionIds.map((regionId) => {
            const destination = REGIONS[regionId]!;
            const roadPreview = getRegionTravelPreview({ ...guild, world: { ...guild.world, currentRegionId: selectedId } }, regionId);
            const destinationUnlocked = guild.world.unlockedRegionIds.includes(regionId);
            return <Pressable accessibilityRole="button" key={regionId} onPress={() => { setSelectedId(regionId); setShowRegionIntel(false); }} style={[styles.road, !destinationUnlocked && styles.roadLocked]}><GameIcon id={destinationUnlocked ? "region_open" : "locked"} size={18} framed={false}/><View><Text style={destinationUnlocked ? styles.roadName : styles.roadNameLocked}>{destination.name}</Text><Text style={styles.roadMeta}>{destinationUnlocked ? `${roadPreview.days}d road` : "Campaign locked"}</Text></View></Pressable>;
          })}</View>
        </View>}

        <View style={styles.buttons}>
          <ActionButton label="OPEN REGION MAP" onPress={() => openRegion(selectedId)} />
          {!current && unlocked && <ActionButton label={`BEGIN JOURNEY · ${travelPreview.days}D · ${travelPreview.rationCost} RATIONS`} disabled={Boolean(travelPreview.blocker)} onPress={travel} />}
          {current && guild.world.currentSettlementId && <ActionButton label={`RESTOCK · +${getRationBundleAmount(guild)} RATIONS · ${GAME_CONFIG.rationBundleGoldCost}G`} onPress={() => { try { const before = guild.rations; const next = buyRations(guild); updateGuild(next); setMessage(`RESTOCKED · +${next.rations - before} rations`); } catch (error) { setMessage(error instanceof Error ? error.message : "Purchase failed"); } }} />}
          <ActionButton label="CAMPAIGN ORDERS" onPress={openCampaign} />
        </View>
        {message && <Text style={styles.message}>{message}</Text>}
      </Panel>

      <SectionTitle>TRAVEL LEDGER</SectionTitle>
      <View style={styles.settlementLedger}>
        {guild.world.discoveredSettlementIds.map((id) => {
          const settlement = SETTLEMENTS[id];
          if (!settlement) return null;
          const isHere = id === guild.world.currentSettlementId;
          return <View key={id} style={[styles.ledgerEntry, isHere && styles.ledgerEntryCurrent]}><GameIcon id={isHere ? "current" : "settlement"} size={18} framed={false}/><View style={styles.flex}><Text style={styles.ledgerName}>{settlement.name}</Text><Text style={styles.ledgerRegion}>{REGIONS[settlement.regionId]?.name ?? formatGameId(settlement.regionId)}</Text></View>{isHere && <Text style={styles.hereLabel}>HERE</Text>}</View>;
        })}
      </View>
    </ScrollView>
  );
}

function RouteStat({ label, value }: { label: string; value: string }) {
  return <View style={styles.routeStat}><Text style={styles.routeStatValue}>{value}</Text><Text style={styles.routeStatLabel}>{label}</Text></View>;
}

function IntelLine({ label, value }: { label: string; value: string }) {
  return <View style={styles.intelLine}><Text style={styles.intelKey}>{label}</Text><Text style={styles.intelValue}>{value}</Text></View>;
}

const styles = StyleSheet.create({
  content: { padding: 16, paddingBottom: 50 },
  eyebrow: { color: colors.gold, fontSize: 9, fontWeight: "900", letterSpacing: 1.5, marginTop: 8 },
  title: { color: colors.text, fontSize: 30, fontWeight: "900", marginTop: 2 },
  subtitle: { color: colors.muted, fontSize: 11, marginTop: 3 },
  flex: { flex: 1 },
  commandBar: { borderColor: colors.gold, marginTop: 13, padding: 11 },
  commandHeader: { alignItems: "center", flexDirection: "row", gap: 9 },
  commandLocationIcon: { alignItems: "center", backgroundColor: "#14271d", borderColor: colors.green, borderWidth: 1, height: 42, justifyContent: "center", width: 42 },
  commandEyebrow: { color: colors.gold, fontSize: 8, fontWeight: "900", letterSpacing: 1.1 },
  commandLocation: { color: colors.text, fontSize: 18, fontWeight: "900", marginTop: 1 },
  commandSub: { color: colors.muted, fontSize: 9, marginTop: 2 },
  supplyPlate: { alignItems: "center", backgroundColor: colors.panel2, borderColor: colors.border, borderWidth: 1, minWidth: 56, paddingHorizontal: 6, paddingVertical: 7 },
  supplyValue: { color: colors.text, fontSize: 18, fontWeight: "900" },
  supplyLabel: { color: colors.gold, fontSize: 7, fontWeight: "900", letterSpacing: .6 },
  overview: { flexDirection: "row", gap: 7, marginTop: 8 },
  overviewStat: { alignItems: "center", backgroundColor: colors.panel, borderColor: colors.border, borderRadius: 2, borderWidth: 1, flex: 1, paddingHorizontal: 4, paddingVertical: 9 },
  overviewValue: { color: colors.text, fontSize: 18, fontWeight: "900" },
  overviewLabel: { color: colors.gold, fontSize: 7, fontWeight: "900", letterSpacing: .6, marginTop: 2, textAlign: "center" },
  mapShade: { backgroundColor: "rgba(4, 11, 17, 0.10)", bottom: 0, left: 0, position: "absolute", right: 0, top: 0 },
  node: { alignItems: "center", backgroundColor: "transparent", borderWidth: 0, marginLeft: -50, marginTop: -15, minHeight: 67, paddingHorizontal: 5, position: "absolute", width: 100 },
  lockedNode: { opacity: 0.7 },
  currentNode: { opacity: 1 },
  selectedNode: { transform: [{ scale: 1.06 }] },
  pressedNode: { opacity: 0.72, transform: [{ scale: 0.96 }] },
  marker: { alignItems: "center", backgroundColor: "#374449", borderColor: "#d4c59d", borderRadius: 2, borderWidth: 1, height: 30, justifyContent: "center", width: 30 },
  currentMarker: { backgroundColor: "#27633e", borderColor: colors.green },
  bossMarker: { backgroundColor: "#762f29", borderColor: colors.danger },
  selectedMarker: { borderColor: colors.gold, borderWidth: 2 },
  nodeName: { color: colors.text, fontSize: 11, fontWeight: "900", marginTop: 3, textAlign: "center", textShadowColor: "#000", textShadowOffset: { width: 0, height: 1 }, textShadowRadius: 3 },
  nodeState: { color: colors.gold, fontSize: 8, fontWeight: "900", letterSpacing: 0.7, marginTop: 2, textShadowColor: "#000", textShadowOffset: { width: 0, height: 1 }, textShadowRadius: 3 },
  nodeHint: { color: colors.green, fontSize: 6, fontWeight: "900", letterSpacing: .4, marginTop: 2 },
  threatBadge: { backgroundColor: "rgba(113, 38, 34, .95)", borderRadius: 2, color: "#ffb0a8", fontSize: 6, fontWeight: "900", marginTop: 2, overflow: "hidden", paddingHorizontal: 3, paddingVertical: 1 },
  settlementRow: { alignItems: "center", flexDirection: "row", gap: 2, marginTop: 2 },
  settlement: { color: colors.muted, fontSize: 7 },
  legendItem: { alignItems: "center", flexDirection: "row", gap: 3 },
  legendText: { color: colors.muted, fontSize: 7, fontWeight: "900", letterSpacing: 0.4 },
  gestureHint: { color: colors.gold, fontSize: 9, fontWeight: "800", marginBottom: 12, marginTop: -7, textAlign: "center" },
  routePanel: { borderColor: "#55635f" },
  panelHeader: { alignItems: "flex-start", flexDirection: "row", gap: 8, justifyContent: "space-between" },
  panelEyebrow: { color: colors.gold, fontSize: 8, fontWeight: "900", letterSpacing: 1.2 },
  regionName: { color: colors.text, fontSize: 23, fontWeight: "900", marginTop: 2 },
  level: { color: colors.gold, fontSize: 10, marginTop: 2 },
  description: { color: colors.muted, lineHeight: 19, marginVertical: 9 },
  regionStats: { flexDirection: "row", gap: 5, marginTop: 3 },
  regionStat: { alignItems: "center", backgroundColor: colors.panel2, borderColor: colors.border, borderWidth: 1, flex: 1, padding: 7 },
  regionStatValue: { color: colors.text, fontSize: 15, fontWeight: "900" },
  regionStatDanger: { color: colors.danger },
  regionStatLabel: { color: colors.muted, fontSize: 7, fontWeight: "900", letterSpacing: .6, marginTop: 2 },
  progressLabel: { color: colors.gold, fontSize: 8, fontWeight: "900", letterSpacing: .8, marginBottom: 4, marginTop: 10 },
  routePlan: { borderWidth: 2, marginTop: 12, padding: 10 },
  routePlanReady: { backgroundColor: "#14251b", borderColor: colors.green },
  routePlanDanger: { backgroundColor: "#291b18", borderColor: colors.danger },
  routePlanBlocked: { backgroundColor: "#1d2021", borderColor: colors.border },
  routePlanHeader: { gap: 3 },
  routePlanTitle: { color: colors.gold, fontSize: 9, fontWeight: "900", letterSpacing: 1.2 },
  routeArrow: { color: colors.text, fontSize: 12, fontWeight: "900" },
  routeNumbers: { flexDirection: "row", gap: 4, marginTop: 9 },
  routeStat: { alignItems: "center", backgroundColor: "rgba(9,14,15,.45)", borderColor: colors.border, borderWidth: 1, flex: 1, paddingVertical: 6 },
  routeStatValue: { color: colors.text, fontSize: 13, fontWeight: "900" },
  routeStatLabel: { color: colors.muted, fontSize: 6, fontWeight: "900", letterSpacing: .5, marginTop: 1 },
  routeError: { color: colors.danger, fontSize: 10, fontWeight: "800", lineHeight: 15, marginTop: 8 },
  routeWarning: { color: colors.gold, fontSize: 10, fontWeight: "800", lineHeight: 15, marginTop: 8 },
  currentPosition: { alignItems: "center", backgroundColor: "#14251b", borderColor: colors.green, borderWidth: 1, flexDirection: "row", gap: 8, marginTop: 11, padding: 9 },
  currentPositionTitle: { color: colors.green, fontSize: 9, fontWeight: "900", letterSpacing: .7 },
  currentPositionText: { color: colors.text, fontSize: 10, marginTop: 2 },
  intelButton: { alignItems: "center", borderColor: colors.border, borderTopWidth: 1, marginTop: 12, paddingVertical: 11 },
  intelLabel: { color: colors.gold, fontSize: 10, fontWeight: "900", letterSpacing: .9 },
  intelBlock: { backgroundColor: colors.panel2, borderColor: colors.border, borderWidth: 1, marginTop: 2, padding: 9 },
  intelLine: { borderBottomColor: colors.border, borderBottomWidth: 1, paddingVertical: 6 },
  intelKey: { color: colors.gold, fontSize: 7, fontWeight: "900", letterSpacing: .7 },
  intelValue: { color: colors.text, fontSize: 10, lineHeight: 15, marginTop: 2 },
