import React from "react";
import { Pressable, StyleSheet, Text, View } from "react-native";
import { SETTLEMENTS } from "../../data/world/settlements";
import { REGIONS } from "../../data/world/regions";
import type { GuildState } from "../../game/guild/types";
import { GameIcon } from "../icons/GameIcon";
import { colors } from "../ui";
import { useTheme } from "../../theme/theme";
import { NotificationBadge } from "./NotificationBadge";
import { useActionNotifications } from "../../state/useActionNotifications";

function Resource({ icon, value, color, danger = false }: { icon: "gold" | "jeweler" | "victory"; value: string | number; color?: string; danger?: boolean }) {
  const { colors: c } = useTheme();
  return <View style={[styles.resource, { backgroundColor: "transparent", borderColor: danger ? c.danger : c.border }]}><GameIcon id={icon} size={17} framed={false} /><Text style={[styles.value, color ? { color } : undefined]}>{value}</Text></View>;
}

export function GlobalResourceHeader({ guild, onOpenGems }: { guild: GuildState; onOpenGems(): void }) {
  const { colors: c } = useTheme();
  const notices = useActionNotifications();
  const region = REGIONS[guild.world.currentRegionId];
  const explicitSettlement = guild.world.currentSettlementId ? SETTLEMENTS[guild.world.currentSettlementId]?.name : undefined;
  const discoveredSettlementId = region?.settlementIds.find((id) => guild.world.discoveredSettlementIds.includes(id));
  const location = explicitSettlement ?? (discoveredSettlementId ? SETTLEMENTS[discoveredSettlementId]?.name : undefined) ?? region?.name ?? "Unknown";
  return <View style={[styles.header, { backgroundColor: c.panel, borderColor: c.border }]}>
    <View style={styles.identity}>
      <View style={styles.guildLine}><Text numberOfLines={1} style={[styles.guild, { color: c.text }]}>{guild.guildName}</Text>{notices.total ? <View style={styles.orderCount}><NotificationBadge count={notices.total} tone={notices.urgent ? "urgent" : "warning"} label={`${notices.total} guild action${notices.total === 1 ? "" : "s"} available`} /></View> : null}</View>
      <Text numberOfLines={1} style={[styles.location, { color: c.muted }]}>DAY {guild.currentDay} · {location.toUpperCase()}</Text>
    </View>
    <View style={styles.resources}>
      <Resource icon="gold" value={guild.gold.toLocaleString()} color={guild.gold < 0 ? c.danger : c.gold} danger={guild.gold < 0} />
      <Pressable accessibilityRole="button" accessibilityLabel={notices.daily ? "Gems & Support. Daily gems available" : "Gems & Support"} onPress={onOpenGems} style={styles.gemButton}>
        <Resource icon="jeweler" value={guild.gems} color={c.blue} />
        {notices.daily ? <View style={styles.notification}><NotificationBadge count={1} tone="ready" label="Daily gems available" /></View> : null}
      </Pressable>
      <Resource icon="victory" value={guild.reputation} color={c.gold} />
    </View>
  </View>;
}

const styles = StyleSheet.create({
  header: { minHeight: 61, borderBottomWidth: 1, borderColor: colors.border, backgroundColor: colors.panel, paddingHorizontal: 10, paddingVertical: 7, flexDirection: "row", justifyContent: "space-between", alignItems: "center", gap: 8 },
  identity: { flex: 1, minWidth: 0 },
  guildLine: { alignItems: "center", flexDirection: "row", gap: 5 },
  guild: { color: colors.text, flexShrink: 1, fontSize: 14, fontWeight: "900" },
  orderCount: { marginTop: -1 },
  location: { color: colors.muted, fontSize: 9, fontWeight: "800", letterSpacing: .4, marginTop: 3 },
  resources: { flexDirection: "row", gap: 4, alignItems: "center" },
  resource: { alignItems: "center", flexDirection: "row", gap: 3, minHeight: 34, paddingHorizontal: 6, borderWidth: 0, borderRadius: 10, },
  value: { color: colors.gold, fontSize: 10, fontWeight: "900" },
  gemButton: { minHeight: 44, justifyContent: "center", position: "relative" },
  notification: { position: "absolute", right: -4, top: -1 },
});
