import React from "react";
import { View } from "react-native";
import { useTheme } from "../../theme/theme";
export function NotificationDot({ label = "Action available" }: { label?: string }) {
  const { colors } = useTheme();
  return <View accessible accessibilityLabel={label} style={{ width: 9, height: 9, borderRadius: 1, borderWidth: 1, borderColor: colors.background, backgroundColor: colors.danger, margin: 3 }} />;
}
